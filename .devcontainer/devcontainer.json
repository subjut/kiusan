{
  "name": "kiusan",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Kiusan (web)",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "KIUSAN_SECRET": "dev-only-secret",
  },
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"]
    }
  }
}
